<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/instance_mod_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_px_book" />

    <TextView
        android:id="@+id/instance_mod_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/primary_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/instance_mod_toggle"
        app:layout_constraintStart_toEndOf="@id/instance_mod_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Sodium" />

    <TextView
        android:id="@+id/instance_mod_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/secondary_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/instance_mod_toggle"
        app:layout_constraintStart_toEndOf="@id/instance_mod_icon"
        app:layout_constraintTop_toBottomOf="@id/instance_mod_name"
        tools:text="No description available" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/instance_mod_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:showText="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbTint="@color/mod_toggle_thumb_tint"
        app:trackTint="@color/mod_toggle_track_tint" />

</androidx.constraintlayout.widget.ConstraintLayout>
